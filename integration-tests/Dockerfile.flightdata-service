FROM maven:3.9.16-eclipse-temurin-17-alpine AS build
WORKDIR /workspace
COPY services/flightdata-service/pom.xml pom.xml
COPY services/flightdata-service/src src
RUN mvn -B -ntp -DskipTests package

FROM eclipse-temurin:17-jre-alpine
WORKDIR /app
RUN addgroup -S appgroup && adduser -S -G appgroup appuser
COPY --chown=appuser:appgroup --from=build /workspace/target/flightdata-service-1.0.0.jar app.jar
USER appuser:appgroup
EXPOSE 8081
HEALTHCHECK --interval=10s --timeout=5s --retries=5 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8081/actuator/health || exit 1
ENTRYPOINT ["java", "-jar", "app.jar"]
