# Local academic demo configuration. Copy to .env if you need to change ports.
# The default demo profile needs no FlightAware or OpenAI key and makes no paid API calls.
APP_PROFILE=demo
FRONTEND_PORT=80
API_GATEWAY_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
ZIPKIN_PORT=9411

# Set APP_PROFILE=prod only after supplying valid provider keys and a strong database password.
FLIGHTAWARE_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6-luna
OPENAI_MAX_TOKENS=150

# Kafka source and dead-letter topic settings; match existing managed-topic partitions when applicable.
KAFKA_TOPIC_FLIGHT_DATA=flight-data-events
KAFKA_TOPIC_PARTITIONS=1
KAFKA_TOPIC_REPLICATION_FACTOR=1

POSTGRES_DB=airline_tracker
POSTGRES_USER=airline_tracker_user
# Demo-only value. Replace with a managed secret before any live deployment.
POSTGRES_PASSWORD=local-academic-demo-only

LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
